# Copy to android/keystore.properties and fill in on the build machine only.
# This file is gitignored — the real keystore and its passwords must NEVER be
# committed. Losing the keystore means you can never update the app on Play,
# so back it up somewhere durable and offline.
#
# Generate a keystore with:
#   keytool -genkeypair -v -keystore familyguard-release.jks \
#           -keyalg RSA -keysize 4096 -validity 10000 -alias familyguard
#
# storeFile is resolved relative to the android/ directory.
storeFile=familyguard-release.jks
storePassword=
keyAlias=familyguard
keyPassword=
