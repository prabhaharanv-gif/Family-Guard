<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Backup off: Android auto-backup would copy the WebView store — which
         holds the Supabase session — into the cloud backup, where restoring it
         onto another device would carry the signed-in session with it. Nothing
         is lost by disabling it: consent is re-read from user_consents on
         sign-in, and the only other local values (active family, mute level,
         language) are re-derived or fall back to the device default. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Crashlytics collection starts OFF and is switched on by
             ConsentGate once the user accepts the privacy policy that
             discloses it. The setting persists, so this only costs reports
             from before first consent. -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />

        <!-- Google Maps SDK for Android (the Map tab). Filled from MAPS_API_KEY
             in android/local.properties via app/build.gradle; never hard-code
             the key here. Native map display is free — this key must NOT have
             the Maps JavaScript API enabled, which is the billed one. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- Locked to portrait: the app is a phone-first family app with no
             landscape layouts, and rotating mid-use (notably when a call or
             alert brought a screen forward) was disorienting. Applies to the
             whole WebView app; the SOS and call screens are locked separately. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── Full-screen SOS alert shown over the lock screen ──────────────
             showWhenLocked + turnScreenOn let it display over the keyguard,
             launched by SOSSirenService's full-screen intent. This is what
             gives a reliable VISUAL alert when the phone is locked. -->
        <activity
            android:name=".SOSAlertActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.scoopfamily.familyguard.sos"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            android:theme="@style/SOSAlertTheme" />

        <!-- ── Full-screen incoming-call UI over the lock screen ──────────────
             Same pattern as SOSAlertActivity, launched by CallRingingService.

             taskAffinity puts it in a task of its OWN. Without it this shares
             MainActivity's task, and the ringing screen was being covered by
             MainActivity again seconds after appearing — no second launch and
             no finish in the logs, just the other activity in the same task
             coming back to the front. A call screen the user has not answered
             yet cannot be something the app's own task can bury. -->
        <activity
            android:name=".CallRingingActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.scoopfamily.familyguard.call"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            android:theme="@style/SOSAlertTheme" />

        <!-- ── SOS countdown with Cancel, shown while a gesture-armed SOS is
             waiting to send. Over the lock screen, own task — same reasons as
             the call and alert screens. -->
        <activity
            android:name=".SosCountdownActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.scoopfamily.familyguard.soscountdown"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            android:theme="@style/SOSAlertTheme" />

        <!-- ── Fake incoming call screen ─────────────────────────────────────
             Same lock-screen pattern as CallRingingActivity, in a task of its
             own for the same reason: nothing in the app's task may bury it. -->
        <activity
            android:name=".FakeCallActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.scoopfamily.familyguard.fakecall"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            android:theme="@style/SOSAlertTheme" />

        <!-- ── FCM background/killed message handler ── -->
        <service
            android:name=".MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- ── Boot receiver — restarts location service after device reboot ──
             Without this, background tracking stops permanently on reboot until
             the user manually reopens the app. -->
        <!--
            Handles both Cancel actions: the one on the countdown shown while a
            power-button SOS is armed (which stops it before anything is sent)
            and the one on the "SOS sent" receipt (which withdraws it). Declared
            rather than registered at runtime because it must still be reachable
            when nothing of ours is running — the notification outlives the
            thread that posted it.

            exported="false": only our own PendingIntent may fire this. Nothing
            else on the device should be able to withdraw a member's SOS.
        -->
        <receiver
            android:name=".SosCancelReceiver"
            android:exported="false" />

        <!-- Periodic check that the location service is still alive; restarts
             it if an OEM killed it. exported="false": only our own alarm fires
             this. See ServiceWatchdogReceiver for why it is needed. -->
        <receiver
            android:name=".ServiceWatchdogReceiver"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Covers HTC/OnePlus fast-boot variants -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- An app update stops the process; without this, location sharing,
                 shake SOS and the fake-call button stay off until someone opens
                 the app again. Sent only to the app that was replaced, so it
                 needs no category and no permission. -->
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- ── SOS siren foreground service ──────────────────────────────────
             foregroundServiceType must include BOTH mediaPlayback (for audio)
             AND specialUse (required on Android 14+ for full-screen intents
             from a non-phone/camera foreground service).
             The <property> tag below is the Google Play declaration required
             when using FOREGROUND_SERVICE_TYPE_SPECIAL_USE. -->
        <service
            android:name=".SOSSirenService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Emergency SOS alarm that requires showing a full-screen alert over the lock screen when a family member is in danger." />
        </service>

        <!-- ── Incoming call ringing foreground service ──────────────────────
             Same mediaPlayback|specialUse justification as SOSSirenService —
             a ringing call needs the full-screen intent over the lock screen. -->
        <service
            android:name=".CallRingingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Incoming voice/video call from a family member that requires showing a full-screen ringing alert over the lock screen." />
        </service>

        <!-- ── "Call me" Quick Settings tile ─────────────────────────────────
             Reachable from the lock screen with a swipe and a tap, which is as
             close to a hardware shortcut as a normal app can get: volume keys
             are never delivered to a background app on MIUI, and the power
             button is the national panic gesture.
             Ships DISABLED: it follows Profile → Fake call → "Call me" button
             (FakeCallPrefs.syncTile), so switching that off removes the tile. -->
        <service
            android:name=".FakeCallTileService"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_fake_call_answer"
            android:label="@string/fake_call_notification_action"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- ── SOS Quick Settings tile ───────────────────────────────────────
             Same shortcut, for an SOS: tap starts the 3-second countdown with
             Cancel. Ships DISABLED — the member turns it on in Profile →
             Safety (SosTileService.setEnabled), because anything that can
             alert every family must be a choice. -->
        <service
            android:name=".SosTileService"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_sos_alert"
            android:label="@string/sos_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- ── Fake incoming call ─────────────────────────────────────────────
             Plays the ringtone and brings a full-screen call over the lock
             screen, like CallRingingService, hence the same types. -->
        <service
            android:name=".FakeCallService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Personal-safety fake incoming call the user schedules for themselves, shown full-screen over the lock screen." />
        </service>

        <!-- ── Find My Device ring foreground service ────────────────────────
             mediaPlayback only — unlike the SOS/call services this one never
             shows a full-screen intent, so it needs no specialUse type and no
             Play Console special-use declaration. -->
        <service
            android:name=".PingRingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- ── Famora Social: "I can help" / "No thanks" notification actions ──
             NearbyHelpRingService is a plain class, not a Service — it posts
             one notification and relies on the channel's own sound and
             vibration, no continuous playback to justify a foreground
             service. Same shape as SosCancelReceiver: exported="false" —
             only our own PendingIntent may fire this. -->
        <receiver
            android:name=".NearbyHelpActionReceiver"
            android:exported="false" />

        <!-- ── Wrong-password alert (Profile → Anti-theft) ─────────────────────
             Device-admin with the "watch-login" policy ONLY: the phone tells us
             about failed unlock attempts. Exported because the system must be
             able to call it, guarded by BIND_DEVICE_ADMIN so nothing else can. -->
        <receiver
            android:name=".AntiTheftAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Takes one front-camera photo after repeated wrong attempts.
             Transparent, over the lock screen, closes itself; only our own
             code starts it. -->
        <activity
            android:name=".IntruderCaptureActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- ── Background location foreground service ──────────────────────
             foregroundServiceType="location" required on Android 10+
             for a foreground service that accesses location.
             START_STICKY ensures Android restarts it after killing it.
        -->
        <service
            android:name=".LocationForegroundService"
            android:exported="false"
            android:foregroundServiceType="location"
            android:stopWithTask="false" />

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

    <!-- ── Network ── -->
    <!-- ── Package visibility ──────────────────────────────────────────────
         Android 11+ hides other apps' activities unless they are declared
         here. RingtonePlugin needs to SEE the sound picker, not just launch
         it: MIUI routes an implicit RINGTONE_PICKER intent through its own
         chooser (MiuiResolverActivity), which measured ~600ms on the test
         device before the real picker even started. With this declaration the
         plugin can resolve the single handler and address it directly, so that
         intermediate screen never appears.

         Narrow by design — this exposes only activities answering this one
         action, not the QUERY_ALL_PACKAGES permission, which Play restricts. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.RINGTONE_PICKER" />
        </intent>
        <!-- The sound sheet's music button has to find the phone's music app
             among the handlers of this action; without this entry the query
             comes back empty and the button falls back to a chooser listing
             file browsers alongside the player. -->
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="audio/*" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Wi-Fi or mobile data, for the signal icon on the family card
         (NetworkSignal). Normal permission: granted at install, no prompt. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ── Location ── -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- ── Wake device ── -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ── Foreground services ── -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Required for mediaPlayback|specialUse combination on Android 14+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- ── Full-screen intent — runtime permission on Android 14+ ── -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- ── Notifications ── -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ── Do Not Disturb ──
         Without this, NotificationChannel.setBypassDnd(true) is silently
         forced back to false the moment the channel is created, and
         setStreamVolume(STREAM_ALARM, ...) throws SecurityException while
         Do Not Disturb is on. Both are exactly what an SOS needs to survive a
         silenced phone, and both were failing invisibly. Declaring it only
         makes the grant POSSIBLE — the user still has to allow Famora under
         Settings > Do Not Disturb access; SosDnd reads that back. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- ── Vibration ── -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- ── Offline SMS alerts ──────────────────────────────────────────────
         Texts the family a member's last known position when the phone has no
         data. Off unless the member turns it on, and requested at that moment.

         Google Play restricts SEND_SMS: this app relies on the "Physical
         safety/emergency alerts to send SMS" exception, which needs the
         Permissions Declaration Form completed in the Play Console for EVERY
         release that ships this permission. Without that approval the listing
         is at risk, so do not add this permission to a build that is uploaded
         before the declaration is in place.

         The form cannot be filed ahead of the upload: Play only generates it
         once a bundle requesting SEND_SMS is uploaded, and an unresolved form
         blocks publishing anything else to that track. So the declaration is
         completed AS PART OF the release that carries this permission, never
         afterwards. Every answer is drafted in
         docs/play-console-declarations-v1.2.md — the exception claimed is
         "Physical safety/emergency alerts to send SMS". -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- ── Alert sound picked from the music app ──────────────────
         A song chosen there is a MediaStore uri, not a document, so no
         persistable grant can be taken on it — the read has to be backed by a
         permission or the alert falls silent once the picking activity is gone.
         Asked for only when the music button is tapped, and only ever one of
         the two: the second is the pre-Android-13 name for the same thing. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- ── Saving chat photos/videos to the gallery (MediaSavePlugin) ──────
         Only Android 7–9 need this: from Android 10 an app adds its own files
         to the gallery through MediaStore without any permission, which is why
         maxSdkVersion stops it at 28. Asked for on the first save, not up front. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- ── Voice/video calling (Agora WebRTC via the Capacitor WebView) ── -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- ── Full-screen incoming call while the phone is UNLOCKED ──────────
         A full-screen intent only takes over the screen when the device is
         locked; while the user is actively using the phone Android demotes it
         to a heads-up banner, so an incoming call looked like an ordinary
         message notification. Background activity starts are also blocked in
         that state. Holding this permission exempts the app from that
         restriction, so CallRingingActivity can be launched directly — the
         same mechanism other calling apps use. Does not affect the locked
         path, which already works via the full-screen intent. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

</manifest>
