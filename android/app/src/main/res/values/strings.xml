<?xml version='1.0' encoding='utf-8'?>
<resources>
    <string name="app_name">Famora</string>
    <string name="title_activity_main">Famora</string>
    <string name="package_name">com.scoopfamily.familyguard</string>
    <string name="custom_url_scheme">com.scoopfamily.familyguard</string>

    <!--
      Notification channel names and descriptions.

      These are the labels Android itself renders in Settings › Apps › Famora ›
      Notifications, so they follow the DEVICE language, not the in-app picker —
      native code cannot read the browser localStorage the picker writes to.
      A Tamil phone gets values-ta automatically.

      Ids are deliberately absent from here: a channel's sound and importance
      are fixed at creation and can only be changed by using a NEW id, so the
      ids stay in Java where the comments explaining each bump live.
    -->
    <string name="ch_sos_name">SOS Emergency Alerts</string>
    <string name="ch_sos_desc">Emergency SOS alerts from family members</string>

    <string name="ch_sos_banner_name">SOS Alert Banner</string>
    <string name="ch_sos_banner_desc">SOS alert banner — audio is provided by the app</string>

    <string name="ch_calls_name">Incoming Calls</string>
    <string name="ch_calls_desc">Incoming voice and video calls from family members</string>

    <string name="ch_call_ring_name">Incoming Calls</string>
    <string name="ch_call_ring_desc">Incoming voice/video calls from family members</string>

    <string name="ch_messages_name">Family Messages</string>
    <string name="ch_messages_desc">New messages from family members</string>

    <string name="ch_messages_silent_name">Family Messages (Silent)</string>
    <string name="ch_messages_silent_desc">Family messages — silent mode</string>
    <string name="ch_messages_popup_silent_name">Family Messages (Pop-up, no sound)</string>
    <string name="ch_messages_popup_silent_desc">Family messages — sound muted, pop-up still shows</string>
    <string name="ch_messages_quiet_name">Family Messages (Sound, no pop-up)</string>
    <string name="ch_messages_quiet_desc">Family messages — pop-up muted, sound still plays</string>

    <string name="ch_location_name">Location Tracking</string>
    <string name="ch_location_desc">Shows while Famora is tracking your location</string>

    <string name="ch_ping_name">Find My Phone</string>
    <string name="ch_ping_desc">Rings this phone when a family member uses Find My Phone</string>

    <!-- Famora Social — nearby-help escalation. ch_nearby_help_* is the
         bystander's ring notification; ch_nearby_help_status_* is the
         low-priority fallback shown on the SOS sender's own phone. -->
    <string name="ch_nearby_help_name">Nearby Help Requests</string>
    <string name="ch_nearby_help_desc">Asks nearby opted-in users to call the right emergency service for someone in danger</string>
    <string name="ch_nearby_help_status_name">Nearby Help Status</string>
    <string name="ch_nearby_help_status_desc">Low-priority updates about a nearby-help request you sent</string>

    <!--
      Native UI and notification text.

      These reach the user from Java, not from the React app, so they follow the
      DEVICE language rather than the in-app picker. That matters most for the
      SOS and call screens below: they are Activities drawn over the lock
      screen, which is the only place Android lets us show anything while the
      phone is locked, so they are what a family member actually reads when an
      alert wakes them.
    -->
    <string name="a_family_member">A family member</string>
    <string name="sos_alert">SOS Alert</string>

    <!-- SOSAlertActivity — full-screen alert over the lock screen -->
    <string name="sos_needs_help">%1$s needs help!</string>
    <string name="sos_view_location">View Location</string>
    <string name="sos_open_app">Open Famora</string>
    <string name="sos_stop_alarm">I Understand — Silence Alarm</string>
    <string name="sos_calm_hint">Stay calm. Check where they are, then call or go to them.</string>
    <string name="sos_call">Call %1$s</string>
    <string name="sos_directions">Get Directions</string>
    <string name="sos_tile_label">SOS</string>
    <string name="sos_tile_subtitle">Alert family</string>
    <!-- Resolved state: the sender marked themselves safe. Silencing the alarm never shows these. -->
    <string name="sos_safe_title">%1$s is safe now</string>
    <string name="sos_marked_safe">%1$s has marked themselves safe.</string>
    <string name="sos_resolved">SOS Resolved</string>
    <string name="sos_still_active">Alarm silenced · SOS still active</string>
    <string name="ch_sos_safe_name">SOS resolved</string>
    <string name="ch_sos_safe_desc">Tells you when a family member marks themselves safe after an SOS</string>

    <!-- Places: a family member reached or left a saved place like Home or Office. -->
    <string name="place_reached_title">%1$s reached %2$s</string>
    <string name="place_left_title">%1$s left %2$s</string>
    <string name="ch_places_name">Places</string>
    <string name="ch_places_desc">Tells you when a family member reaches or leaves a saved place, like Home or Office</string>

    <!-- CallRingingActivity — full-screen incoming call over the lock screen -->
    <string name="call_incoming_voice">Incoming voice call</string>
    <string name="call_incoming_video">Incoming video call</string>
    <string name="call_decline">✕ Decline</string>
    <string name="call_accept">✓ Accept</string>

    <!-- Notifications built natively -->
    <string name="notif_sos_title">🚨 SOS — %1$s needs help!</string>
    <string name="notif_sos_big">⚠️ %1$s needs help!\n\n%2$s\n\nTap to open Famora.</string>
    <string name="notif_call_voice_label">Voice call</string>
    <string name="notif_call_video_label">Video call</string>
    <string name="notif_call_title">📞 %1$s from %2$s</string>
    <string name="notif_tap_to_answer">Tap to answer</string>
    <!--
      The Stop action button on the Find My Phone notification. It was a
      hardcoded Java literal until now, so it read "Stop" on every device
      while notif_ping_big told the reader to tap a translated word that did
      not exist. Whatever this says, notif_ping_big below must name the same
      word, in every language.
    -->
    <string name="notif_action_stop">Stop</string>

    <string name="notif_ping_title">📡 Found it!</string>
    <string name="notif_ping_body">%1$s is looking for this phone</string>
    <string name="notif_ping_big">%1$s is looking for this phone.\n\nTap Stop to silence it.</string>
    <string name="notif_location_body">Protecting your family · location active</string>
    <string name="notif_tap_to_open">Tap to open</string>
    <string name="ch_reauth_name">Reconnection needed</string>
    <string name="ch_reauth_desc">Alerts you when Famora must be reopened to keep sharing your location</string>
    <string name="notif_reauth_title">Location sharing paused</string>
    <string name="notif_reauth_body">Open Famora to reconnect. Your family cannot see your location until you do.</string>

    <!-- Offline SMS. Kept short: every 160 characters is another charge, and
         Indian scripts fit only 70 per part. -->
    <string name="sms_offline_body">Famora: %1$s has no internet since %2$s. Last known location: %3$s</string>
    <string name="sms_no_location">no location available</string>
    <string name="sms_test_prefix">[Test]</string>

    <!-- SOS countdown screen, shown while a shake-armed SOS can still be stopped -->
    <string name="sos_countdown_title">Sending SOS to your family</string>
    <string name="sos_countdown_hint">Tap Cancel if you did not mean to do this.</string>
    <string name="sos_countdown_cancel">Cancel</string>

    <!-- Famora Social — nearby-help bystander notification (NearbyHelpRingService,
         NearbyHelpActionReceiver). "Never asked to go" is repeated in the body
         on purpose — see the plan's safety boundary in §7. -->
    <string name="notif_nearby_help_title">Someone nearby may need help</string>
    <string name="notif_nearby_help_body">Someone within about %1$s needs %2$s. Would you call %3$s for them?</string>
    <string name="kind_need_police">the police</string>
    <string name="kind_need_ambulance">an ambulance</string>
    <string name="kind_need_disaster">emergency rescue</string>
    <string name="kind_need_fire">the fire brigade</string>
    <string name="notif_nearby_help_note">You\'ll only ever be asked to call — never to go there.</string>
    <string name="notif_action_help">I can help</string>
    <string name="notif_action_no_thanks">No thanks</string>
    <string name="notif_action_call_number">Call %1$s</string>
    <string name="notif_action_open_maps">Open in Maps</string>
    <string name="notif_nearby_help_already_title">Already being handled</string>
    <string name="notif_nearby_help_already_body">Thank you — someone else is already helping.</string>
    <string name="notif_nearby_help_accepted_title">Location revealed</string>
    <string name="notif_nearby_help_accepted_body">%1$s — call %2$s or open it in Maps.</string>

    <!-- Famora Social — sender-side fallback (MyFirebaseMessagingService).
         Count/status only, never a helper's identity — the live case is
         handled by the web layer over Supabase Realtime; this is only shown
         when the app was backgrounded or killed. -->
    <string name="notif_nearby_help_sender_accepted_title">Help is on the way</string>
    <string name="notif_nearby_help_sender_accepted_body">Someone nearby is calling for you.</string>
    <string name="notif_nearby_help_sender_exhausted_title">No one nearby found</string>
    <string name="notif_nearby_help_sender_exhausted_body">Call %1$s now if you still need help.</string>

    <!-- Fake call. The countdown notification and the notification button are
         worded so they do not say "fake" to someone reading the lock screen. -->
    <string name="fake_call_default_name">Mom</string>
    <string name="fake_call_scheduled_title">Reminder</string>
    <string name="fake_call_cancel">Cancel</string>
    <string name="fake_call_incoming">Incoming call</string>
    <string name="fake_call_mobile">Mobile</string>
    <string name="fake_call_answer">Answer</string>
    <string name="fake_call_decline">Decline</string>
    <string name="fake_call_end">End</string>
    <string name="fake_call_notification_action">Call me</string>
    <string name="fake_call_tile_subtitle">Fake call in 5s</string>
    <string name="ch_fake_call_name">Fake call</string>
    <string name="ch_fake_call_quiet_name">Fake call (silent)</string>
    <string name="ch_fake_call_desc">A fake incoming call you schedule for yourself</string>
    <!-- Spoken into the earpiece after answering, one line at a time with pauses. Lines are separated by | -->
    <string name="fake_call_voice_script">Hello? Hi, where are you right now?|Okay. I\'m close by, I\'m coming to you.|Stay where you are, I\'ll be there in two minutes.|Yes, I\'m on my way. Don\'t hang up.</string>

    <!-- Device alerts (MyFirebaseMessagingService): low battery, phone off, back online. -->
    <string name="ch_device_name">Battery and phone status</string>
    <string name="ch_weather_name">Weather alerts</string>
    <string name="ch_weather_desc">Warns you about severe weather at your saved places</string>
    <string name="ch_device_desc">Tells you when a family member\'s battery is low or their phone has gone offline</string>
    <string name="device_low_title">%1$s\'s battery is low</string>
    <string name="device_low_body">%1$s left. Their location keeps updating until it runs out.</string>
    <string name="device_critical_title">%1$s\'s phone is almost out of battery</string>
    <string name="device_critical_body">%1$s left — it may switch off very soon.</string>
    <string name="device_offline_title">%1$s hasn\'t been reachable</string>
    <string name="device_offline_body">No update for %1$s. Their phone may be off or have no signal.</string>
    <string name="device_offline_body_battery">No update for %1$s. Their battery was at %2$s, so it may have run out.</string>
    <string name="device_back_title">%1$s is back online</string>
    <string name="device_back_body">Their phone is reporting again.</string>
    <string name="weather_title_thunderstorm" formatted="true">Thunderstorm near %1$s</string>
    <string name="weather_detail_thunderstorm" formatted="true">Thunder and lightning are likely.</string>
    <string name="weather_title_heavy_rain" formatted="true">Heavy rain near %1$s</string>
    <string name="weather_detail_heavy_rain" formatted="true">Heavy rain is likely.</string>
    <string name="weather_detail_heavy_rain_mm" formatted="true">About %1$d mm expected.</string>
    <string name="weather_title_heat" formatted="true">Extreme heat near %1$s</string>
    <string name="weather_detail_heat" formatted="true">Around %1$d°C. Stay hydrated.</string>
    <string name="weather_title_wind" formatted="true">Strong winds near %1$s</string>
    <string name="weather_detail_wind" formatted="true">Gusts up to %1$d km/h.</string>
    <string name="weather_when_now" formatted="true">Expected now</string>
    <string name="weather_when_at" formatted="true">Expected around %1$s</string>
    <string name="weather_body">%1$s. %2$s</string>
    <string name="device_overspeed_title" formatted="true">%1$s is driving fast</string>
    <string name="device_overspeed_body" formatted="true">Going %1$d km/h (limit %2$d km/h)</string>
    <string name="device_overspeed_self_title">Slow down: you are over your speed limit</string>
    <string name="device_overspeed_self_body" formatted="true">You are going %1$d km/h. Your limit is %2$d km/h.</string>
    <string name="unlock_alert_title" formatted="true">Wrong password on %1$s\'s phone</string>
    <string name="unlock_alert_body" formatted="true">Wrong screen-lock attempts: %1$d. Open Famora to see where the phone was, and a photo if one was taken.</string>
    <string name="ch_lost_name">Phone lost mode</string>
    <string name="ch_lost_desc">Shown while this phone has been marked lost by your family</string>
    <string name="lost_title">This phone is lost</string>
    <string name="lost_body_default" formatted="true">Please contact %1$s to return it.</string>
    <string name="lost_body_generic">Please return this phone to its owner\'s family.</string>
</resources>
