<?xml version="1.0" encoding="utf-8"?>
<!-- Fully transparent drawable used as the Android 12+ splash icon.
     With a transparent icon on a maroon icon-background over a maroon
     window background, the system splash renders as solid maroon with
     NO shield. Only the home-screen launcher icon remains visible on
     launch. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#00000000" />
    <size android:width="108dp" android:height="108dp" />
</shape>
