<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (targetSdk 31+) backup/transfer rules.

  FamilyGuard stores the live Supabase session token, the user id and the
  family id in SharedPreferences so LocationForegroundService can post
  location updates while the app is closed. Those values are credentials:
  anyone who restores them onto another device gets the family's real-time
  location. Nothing this app stores may leave the device, so both
  cloud-backup and device-to-device transfer are fully excluded.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root"           />
        <exclude domain="file"           />
        <exclude domain="database"       />
        <exclude domain="sharedpref"     />
        <exclude domain="external"       />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root"           />
        <exclude domain="file"           />
        <exclude domain="database"       />
        <exclude domain="sharedpref"     />
        <exclude domain="external"       />
    </device-transfer>
</data-extraction-rules>
