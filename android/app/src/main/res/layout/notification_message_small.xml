<?xml version="1.0" encoding="utf-8"?>
<!--
    Collapsed and heads-up form. Android gives a custom view only about 48dp of
    height here, so this is deliberately tight: one line each for sender and text.
    The expanded form (notification_message_big) has room for the whole message.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_message_bubble"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="4dp"
    android:paddingEnd="12dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/msg_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/msg_notif_title"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/msg_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/msg_notif_text"
        android:textSize="13sp" />
</LinearLayout>
