<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Android 12+ (API 31+) system splash.
        The splash icon is now a TRANSPARENT drawable, so the launch screen
        shows a solid maroon background with NO shield. The only shield the
        user sees on launch is the home-screen launcher icon. This removes
        the "second shield" that came from windowSplashScreenAnimatedIcon.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#951345</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_none</item>
        <item name="windowSplashScreenIconBackgroundColor">#951345</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
