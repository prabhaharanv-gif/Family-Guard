# Release signing — never commit
android/keystore.properties
*.jks
*.keystore
# Except the debug keystore: not a secret (see android/app/build.gradle), and
# committing it is what lets a CI-built debug APK update in place.
!android/ci-debug-keystore/debug.keystore
.vercel
.env*

# Raw device logs
log.txt
