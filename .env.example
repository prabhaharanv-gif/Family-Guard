# Copy to .env and fill in from the Supabase dashboard:
# Project Settings → API → Project URL / Project API keys → anon public.
#
# .env is gitignored (it is not a secret store — both values ship in the
# client bundle — but it is machine-local, so it does not belong in git).
# Keep a copy somewhere outside the repo: a branch switch that removes a
# tracked .env deletes it from disk.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
