+    // ── Famora patch (patches/@capacitor+google-maps+8.0.1.patch) ─────────────
+    //
+    // The stock plugin can only add or remove a marker, so a pin could only
+    // teleport. Family members' pins glide between location fixes, and doing
+    // that from JS would mean removing and re-adding every marker ~30 times a
+    // second across the bridge. The glide runs here instead, on the UI thread,
+    // as one ValueAnimator per marker.
+    fun animateMarker(
+            id: String,
+            lat: Double,
+            lng: Double,
+            durationMs: Long,
+            callback: (error: GoogleMapsError?) -> Unit
+    ) {
+        try {
+            googleMap ?: throw GoogleMapNotAvailable()
+            val marker = markers[id]
+            marker ?: throw MarkerNotFoundError()
+
+            CoroutineScope(Dispatchers.Main).launch {
+                val gm = marker.googleMapMarker
+                if (gm == null) {
+                    callback(null)
+                    return@launch
+                }
+                markerAnimators.remove(id)?.cancel()
+
+                val to = LatLng(lat, lng)
+                if (durationMs <= 0) {
+                    gm.position = to
+                    callback(null)
+                    return@launch
+                }
+                // Start from wherever the pin is drawn right now — mid-glide if
+                // a previous fix is still animating — so it never jumps back.
+                val from = gm.position
+                val anim = android.animation.ValueAnimator.ofFloat(0f, 1f)
+                anim.duration = durationMs
+                // Same shape as the Leaflet version's easeInOutQuad.
+                anim.interpolator = android.view.animation.AccelerateDecelerateInterpolator()
+                anim.addUpdateListener { a ->
+                    val t = a.animatedFraction.toDouble()
+                    gm.position = LatLng(
+                            from.latitude + (to.latitude - from.latitude) * t,
+                            from.longitude + (to.longitude - from.longitude) * t
+                    )
+                }
+                markerAnimators[id] = anim
+                anim.start()
+                callback(null)
+            }
+        } catch (e: GoogleMapsError) {
+            callback(e)
+        }
+    }
